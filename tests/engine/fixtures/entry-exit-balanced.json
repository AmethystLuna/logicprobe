{
  "schemaVersion": 1,
  "init": "INIT",
  "states": [
    {
      "id": "INIT"
    },
    {
      "id": "ACTIVE",
      "onEntry": [
        "lock"
      ],
      "onExit": [
        "unlock"
      ]
    },
    {
      "id": "DONE",
      "terminal": true
    }
  ],
  "transitions": [
    {
      "from": "INIT",
      "event": "go",
      "to": "ACTIVE"
    },
    {
      "from": "ACTIVE",
      "event": "finish",
      "to": "DONE"
    }
  ],
  "resourcePairs": [
    {
      "resource": "mutex",
      "acquireEvent": "lock",
      "releaseEvent": "unlock"
    }
  ]
}
