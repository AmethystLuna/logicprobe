@startuml
' The motion module as drawn: two packages, a service, an adapter, the HAL driver,
' an orphan cache that nothing uses, and one arrow into a component nobody declared.
package "app" {
  component [Motion Service] as MS
  component [Locator Adapter] as LA
}
package "hal" {
  component [AT32 Driver] as DRV
}
component [Orphan Cache] as CACHE
component [Persistence] as DB
MS --> LA : plan
LA --> DRV : read
DRV --> MS : fault
MS --> GHOST : unknown
LA --> DB : store
@enduml
